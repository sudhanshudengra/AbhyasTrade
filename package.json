{
  "name": "abhyastrade",
  "version": "1.0.0",
  "description": "AbhyasTrade – NSE Virtual Trading Terminal",
  "scripts": {
    "dev:backend": "backend\\venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:frontend": "npm --prefix frontend install",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md,html,yml,yaml}\" && backend\\venv\\Scripts\\python.exe -m ruff format backend",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md,html,yml,yaml}\" && backend\\venv\\Scripts\\python.exe -m ruff format --check backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.8.3"
  }
}
