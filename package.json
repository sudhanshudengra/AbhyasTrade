{
  "name": "abhyastrade",
  "version": "1.0.0",
  "description": "AbhyasTrade – NSE Virtual Trading Terminal",
  "scripts": {
    "dev:backend": "backend\\venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:frontend": "npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
