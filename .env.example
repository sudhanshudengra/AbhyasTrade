PROJECT_NAME="AbhyasTrade"
API_V1_STR="/api"

# Supabase Credentials — get these from your Supabase project dashboard
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-public-key"

VIRTUAL_INITIAL_CASH=1000000.00
DEFAULT_USER_ID="00000000-0000-0000-0000-000000000001"
NSE_REFRESH_INTERVAL=1.5
SIMULATION_MODE_AUTO=true

# AI Provider Credentials & Configuration (Server-Side Only)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

AI_DEFAULT_PROVIDER="gemini"
AI_ENABLE_FALLBACK=true

# Cache TTLs (Seconds) - 3-hour freshness cycle
AI_CACHE_STOCK_TTL=10800
AI_CACHE_PEER_TTL=10800
AI_CACHE_SENTIMENT_TTL=1800
AI_CACHE_EDUCATION_TTL=2592000

# Rate Limiting & User Quotas
AI_STOCKS_DAILY_LIMIT=10
AI_QUIZ_DAILY_LIMIT=5
AI_USER_DAILY_LIMIT=10
AI_HEAVY_DAILY_LIMIT=5
AI_PER_MINUTE_LIMIT=5
AI_GLOBAL_CONCURRENCY_LIMIT=10
